# Environment Variables for Portfolio AI

# ─── FRONTEND (попадают в браузерный бандл через Vite) ───────────────────────
# Только публичные ключи! Никогда не добавляй сюда секреты с VITE_ префиксом.
# Получить: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# ─── BACKEND / Edge Functions (НЕ попадают в браузер) ────────────────────────
# Устанавливать через: supabase secrets set KEY=value
# Или локально через: supabase functions serve --env-file .env

# AI (Google Gemini) — для чат-бота
# Получить: https://aistudio.google.com/app/apikeys
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram — форма обратной связи и уведомления о лидах
# Токен получить у @BotFather: https://t.me/BotFather
# Chat ID получить у @userinfobot: https://t.me/userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# CORS — разрешённый источник запросов к Edge Functions
# Продакшен: https://your-portfolio-domain.com
# Локально: http://localhost:8080
ALLOWED_ORIGIN=http://localhost:8080
